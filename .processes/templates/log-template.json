{
  "type": "template",
  "name": "log-template",
  "category": "utility",
  "metadata": {
    "title": "Process Detailed Log Template",
    "purposeAndUsage": "Template defining the structure for detailed process log files that capture comprehensive information about process execution. Used when creating log files for process instances.",
    "lastUpdated": "2026-01-19"
  },
  "logSections": [
    {
      "name": "Type Discriminator",
      "required": true,
      "fields": ["type"],
      "note": "Always set to 'log-file'"
    },
    {
      "name": "Metadata",
      "required": true,
      "fields": ["process", "template", "started", "completed", "parentProcessPath", "subProcessPaths"]
    },
    {
      "name": "Step Section",
      "required": true,
      "repeatable": true,
      "keyFormat": "StepId (UUID)",
      "subsections": ["timestamp", "actionsTaken", "agentReasoning", "userInteractions", "problemsEncountered", "filesModified", "decisionsMade", "performanceNotes"]
    },
    {
      "name": "Process-Wide Observations",
      "required": true,
      "subsections": ["patternsDetected", "userFeedbackSummary", "efficiencyMetrics", "recommendationsForFuture"]
    }
  ],
  "criticalSections": [
    {
      "name": "userInteractions",
      "importance": "Critical for learning and improvement",
      "mandatoryWorkflow": "Log BEFORE making file changes"
    }
  ],
  "relationship": {
    "memoryFile": "What was produced (results)",
    "logFile": "How it was produced (process)"
  },
  "references": {
    "relatedFiles": ["memory-template.md", "docs/process-management.md"],
    "dependencies": []
  }
}




