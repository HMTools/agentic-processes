{
  "type": "template",
  "name": "memory-template",
  "category": "utility",
  "metadata": {
    "title": "Process Memory Template",
    "purposeAndUsage": "Template defining the structure for process memory files that track state and share information between steps. Used when creating memory files for process instances.",
    "lastUpdated": "2026-01-19"
  },
  "memorySections": [
    {
      "name": "Type Discriminator",
      "required": true,
      "fields": ["type"],
      "note": "Always set to 'memory-file'"
    },
    {
      "name": "Metadata",
      "required": true,
      "fields": ["process", "template", "created", "lastUpdated", "currentStep"]
    },
    {
      "name": "Sub-Process State",
      "required": false,
      "purpose": "Track parent-child relationships and sync points",
      "subsections": ["parentProcessPath", "childSubProcesses", "syncPoints"]
    },
    {
      "name": "Step Section",
      "required": true,
      "repeatable": true,
      "keyFormat": "StepId (UUID)",
      "subsections": ["name", "status", "startedAt", "updatedAt", "informationProduced", "decisionsMade", "filesModifiedCreated", "notes"]
    },
    {
      "name": "Cross-References",
      "required": false,
      "purpose": "Quick lookup for common items",
      "examples": ["apiEndpoints", "databaseChanges", "keyDecisions"]
    },
    {
      "name": "Search Helpers",
      "required": false,
      "purpose": "Navigation aids by category"
    }
  ],
  "contentGuidelines": {
    "informationProduced": [
      "Files created or modified",
      "API endpoints defined",
      "Database schema changes",
      "Requirements identified",
      "Technical designs created"
    ],
    "decisionsMade": [
      "Technical approach choices",
      "Architecture decisions",
      "Library/framework selections",
      "Design pattern choices"
    ],
    "notes": [
      "Context for understanding work",
      "References to previous steps",
      "Constraints discovered",
      "Future considerations"
    ]
  },
  "relationship": {
    "memoryFile": "What was produced (results)",
    "logFile": "How it was produced (process)"
  },
  "references": {
    "relatedFiles": ["log-template.md", "docs/process-management.md"],
    "dependencies": []
  }
}




