{
  "type": "template",
  "name": "set-concept",
  "category": "infrastructure",
  "metadata": {
    "title": "Set Concept",
    "purposeAndUsage": "Systematic workflow for implementing or updating a concept (pattern, structure, standard, or approach) across non-code files. Use when you need to implement a new pattern across documentation, update an existing concept consistently, or apply best practices to non-code files.",
    "lastUpdated": "2026-01-19"
  },
  "parameters": {
    "required": ["conceptName", "conceptDescription", "targetFiles"],
    "optional": ["existingState", "requestedState", "verificationCriteria", "excludePatterns"],
    "definitions": {
      "conceptName": {
        "description": "Name of the concept to implement",
        "type": "string",
        "example": "Layered Documentation Structure"
      },
      "conceptDescription": {
        "description": "Detailed description of what the concept entails",
        "type": "string",
        "example": "Separate user-readable content from agent instructions in markdown files"
      },
      "targetFiles": {
        "description": "Files or patterns to apply the concept to",
        "type": "string",
        "example": "All markdown files in .processes/"
      },
      "existingState": {
        "description": "Description of current state before implementation",
        "type": "string",
        "example": "Files mix user and agent content without separation"
      },
      "requestedState": {
        "description": "Description of desired end state after implementation",
        "type": "string",
        "example": "Clear separation between user layer and agent layer"
      },
      "verificationCriteria": {
        "description": "Criteria to verify successful implementation",
        "type": "string",
        "example": "All files have clear layer separation, JSON companions exist"
      },
      "excludePatterns": {
        "description": "File patterns to exclude from processing",
        "type": "string",
        "example": "*.test.md, drafts/**"
      }
    }
  },
  "structure": {
    "userLayer": {
      "sections": ["description", "purposeAndUsage", "quickReference"]
    },
    "agentLayer": {
      "sections": ["currentState", "parametersFull", "context", "processFlowDetailed", "steps", "memoryFile", "errorsNotes", "auditLog"]
    }
  },
  "steps": [
    {
      "number": 1,
      "name": "Understand concept",
      "stepRef": "@framework-step:planning/understand-context",
      "output": "Context documentation"
    },
    {
      "number": 2,
      "name": "Identify target files",
      "stepRef": "@framework-step:investigation/identify-files",
      "output": "List of target files in identified-files.json"
    },
    {
      "number": 3,
      "name": "Analyze existing state",
      "stepRef": "@framework-step:investigation/review-verify-document",
      "output": "Findings report"
    },
    {
      "number": 4,
      "name": "Design implementation plan",
      "stepRef": "@framework-step:planning/design-implementation-plan",
      "output": "Implementation plan with change proposals",
      "approvalRequired": true
    },
    {
      "number": 5,
      "name": "Apply changes",
      "stepRef": "@framework-step:common/apply-changes",
      "output": "Modified and newly created files"
    },
    {
      "number": 6,
      "name": "Verify implementation",
      "stepRef": "@framework-step:investigation/review-verify-document",
      "output": "Verification report"
    },
    {
      "number": 7,
      "name": "Continuous Improvement",
      "stepRef": "@framework-step:learning/continuous-improvement",
      "output": "Improvements implemented"
    }
  ],
  "references": {
    "steps": [
      "@framework-step:planning/understand-context",
      "@framework-step:investigation/identify-files",
      "@framework-step:investigation/review-verify-document",
      "@framework-step:planning/design-implementation-plan",
      "@framework-step:common/apply-changes",
      "@framework-step:learning/continuous-improvement"
    ],
    "relatedTemplates": ["review-and-verify"],
    "dependencies": []
  }
}





