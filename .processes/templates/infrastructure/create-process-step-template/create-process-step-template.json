{
  "type": "template",
  "name": "create-process-step-template",
  "category": "infrastructure",
  "metadata": {
    "title": "Create Process Step Template",
    "purposeAndUsage": "End-to-end workflow for creating new process step files from requirements through validation. Use when you need to create a new reusable process step for the Agentic Process System.",
    "lastUpdated": "2026-01-19"
  },
  "parameters": {
    "required": ["stepName", "stepCategory", "stepPurpose", "useCases"],
    "optional": ["exampleContext"],
    "definitions": {
      "stepName": {
        "description": "Name of the step file (kebab-case)",
        "type": "string",
        "example": "validate-input-schema"
      },
      "stepCategory": {
        "description": "Category folder for the step",
        "type": "string",
        "example": "planning",
        "enum": ["planning", "investigation", "common", "api", "service", "data", "testing", "template", "documentation", "external-services", "learning"]
      },
      "stepPurpose": {
        "description": "What the step accomplishes",
        "type": "string",
        "example": "Validates input data against defined JSON schema"
      },
      "useCases": {
        "description": "Scenarios when this step should be used",
        "type": "string",
        "example": "Before processing user input, validating API request bodies"
      },
      "exampleContext": {
        "description": "Example context values for testing the step",
        "type": "object",
        "example": {"inputPath": "data/input.json", "schemaPath": "schemas/input.schema.json"}
      }
    }
  },
  "steps": [
    {
      "number": 0,
      "name": "Init Process Principles",
      "stepRef": "@step:common/init-process-principles",
      "output": "Principles loaded and confirmed"
    },
    {
      "number": 1,
      "name": "Plan and design step",
      "stepRef": "@step:template/plan-and-design-step",
      "output": "Requirements document, design artifacts, mermaid diagram",
      "approvalRequired": true
    },
    {
      "number": 2,
      "name": "Create step file",
      "stepRef": "@step:template/create-step-file",
      "output": "Complete step file with validation reports",
      "approvalRequired": true
    },
    {
      "number": 3,
      "name": "Validate step structure",
      "stepRef": "@step:template/validate-step-structure",
      "output": "Comprehensive validation report"
    },
    {
      "number": 4,
      "name": "Continuous Improvement",
      "stepRef": "@step:learning/continuous-improvement",
      "output": "Improvements implemented",
      "approvalRequired": true
    },
    {
      "number": 5,
      "name": "End Process Validation",
      "stepRef": "@step:common/end-process-validation",
      "output": "Compliance report"
    }
  ],
  "references": {
    "steps": [
      "@step:template/plan-and-design-step",
      "@step:template/create-step-file",
      "@step:template/validate-step-structure",
      "@step:learning/continuous-improvement",
      "@step:common/end-process-validation"
    ],
    "relatedTemplates": ["create-process-template"],
    "dependencies": []
  }
}






