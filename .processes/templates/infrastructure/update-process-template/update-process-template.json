{
  "type": "template",
  "name": "update-process-template",
  "category": "infrastructure",
  "metadata": {
    "title": "Update Process Template",
    "purposeAndUsage": "Workflow for safely modifying existing process templates. Use when you need to update a template's steps, parameters, structure, or documentation while ensuring all references remain valid.",
    "lastUpdated": "2026-02-05"
  },
  "parameters": {
    "required": ["templateName", "updateDescription"],
    "optional": ["changeScope", "preserveActiveProcesses"],
    "definitions": {
      "templateName": {
        "description": "Name of the template to update",
        "type": "string",
        "example": "code-review"
      },
      "updateDescription": {
        "description": "Description of what changes are needed",
        "type": "string",
        "example": "Add approval checkpoint after analysis step"
      },
      "changeScope": {
        "description": "Scope of changes: minor (small fixes) or major (structural changes)",
        "type": "string",
        "example": "major"
      },
      "preserveActiveProcesses": {
        "description": "Whether to warn if active processes use this template",
        "type": "boolean",
        "example": true
      }
    }
  },
  "steps": [
    {
      "number": 0,
      "name": "Init Process Principles",
      "stepRef": "@framework-step:common/init-process-principles",
      "output": "Principles loaded and confirmed"
    },
    {
      "number": 1,
      "name": "Analyze Existing Template",
      "stepRef": "@framework-step:template/analyze-existing-template",
      "output": "Template analysis with current structure, steps, parameters documented in memory"
    },
    {
      "number": 2,
      "name": "Plan Template Updates",
      "stepRef": "@framework-step:common/plan-artifact-updates",
      "output": "update-plan.md with proposed changes",
      "approvalRequired": true
    },
    {
      "number": 3,
      "name": "Apply Template Updates",
      "stepRef": "@framework-step:template/apply-template-updates",
      "output": "Updated template JSON and MD files"
    },
    {
      "number": 4,
      "name": "Review and Validate Updates",
      "stepRef": "@framework-step:template/review-and-validate-updates",
      "output": "review-report.md with plan compliance and validation results",
      "approvalRequired": true
    },
    {
      "number": 5,
      "name": "Validate Process Steps Exist",
      "stepRef": "@framework-step:template/validate-process-steps-exist",
      "output": "Validation report",
      "subProcessTrigger": {
        "condition": "missing steps found",
        "template": "create-process-step-template",
        "forEach": "missingStep",
        "syncPoint": "immediate"
      },
      "fallback": "manual PAUSE if user prefers"
    },
    {
      "number": 6,
      "name": "Continuous Improvement",
      "stepRef": "@framework-step:learning/continuous-improvement",
      "output": "Improvements implemented",
      "approvalRequired": true
    },
    {
      "number": 7,
      "name": "End Process Validation",
      "stepRef": "@framework-step:common/end-process-validation",
      "output": "Compliance report"
    }
  ],
  "references": {
    "steps": [
      "@framework-step:common/init-process-principles",
      "@framework-step:template/analyze-existing-template",
      "@framework-step:common/plan-artifact-updates",
      "@framework-step:template/apply-template-updates",
      "@framework-step:template/review-and-validate-updates",
      "@framework-step:template/validate-process-steps-exist",
      "@framework-step:learning/continuous-improvement",
      "@framework-step:common/end-process-validation"
    ],
    "relatedTemplates": ["create-process-template", "create-process-step-template"],
    "dependencies": []
  }
}
