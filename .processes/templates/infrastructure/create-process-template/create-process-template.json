{
  "type": "template",
  "name": "create-process-template",
  "category": "infrastructure",
  "metadata": {
    "title": "Create Process Template",
    "purposeAndUsage": "End-to-end workflow for creating new process templates from requirements through validation. Use when you need to create a new reusable process template for the Agentic Process System.",
    "lastUpdated": "2026-01-19"
  },
  "parameters": {
    "required": ["templateName", "templatePurpose", "useCases"],
    "optional": ["exampleParameters"],
    "definitions": {
      "templateName": {
        "description": "Name of the template to create",
        "type": "string",
        "example": "code-review"
      },
      "templatePurpose": {
        "description": "What the template is designed to accomplish",
        "type": "string",
        "example": "Systematic code review workflow with checklist and feedback"
      },
      "useCases": {
        "description": "Scenarios where this template should be used",
        "type": "string",
        "example": "Pull request reviews, pre-merge code quality checks"
      },
      "exampleParameters": {
        "description": "Example parameter values for testing the template",
        "type": "object",
        "example": {"reviewScope": "backend", "reviewType": "security"}
      }
    }
  },
  "steps": [
    {
      "number": 0,
      "name": "Init Process Principles",
      "stepRef": "@step:common/init-process-principles",
      "output": "Principles loaded and confirmed"
    },
    {
      "number": 1,
      "name": "Plan and design template",
      "stepRef": "@step:template/plan-and-design-template",
      "output": "Requirements document, design artifacts, mermaid diagram",
      "approvalRequired": true
    },
    {
      "number": 2,
      "name": "Create template file",
      "stepRef": "@step:template/create-template-file",
      "output": "Complete template file with validation reports"
    },
    {
      "number": 3,
      "name": "Validate process-steps exist",
      "stepRef": "@step:template/validate-process-steps-exist",
      "output": "Validation report",
      "subProcessTrigger": {
        "condition": "missing steps found",
        "template": "create-process-step-template",
        "forEach": "missingStep",
        "syncPoint": "immediate"
      },
      "fallback": "manual PAUSE if user prefers"
    },
    {
      "number": 4,
      "name": "Continuous Improvement",
      "stepRef": "@step:learning/continuous-improvement",
      "output": "Improvements implemented",
      "approvalRequired": true
    },
    {
      "number": 5,
      "name": "End Process Validation",
      "stepRef": "@step:common/end-process-validation",
      "output": "Compliance report"
    }
  ],
  "references": {
    "steps": [
      "@step:template/plan-and-design-template",
      "@step:template/create-template-file",
      "@step:template/validate-process-steps-exist",
      "@step:learning/continuous-improvement",
      "@step:common/end-process-validation"
    ],
    "relatedTemplates": ["create-process-step-template"],
    "dependencies": []
  }
}




