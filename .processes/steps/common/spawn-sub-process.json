  "metadata": {
    "title": "Spawn Sub-Process",
    "purposeAndUsage": "Create a sub-process from within a parent process with proper parent-child linking and sync point configuration.",
    "lastUpdated": "2026-01-20"
  },
  "parameters": {
    "required": ["template", "parameters"],
    "optional": ["syncPoint"],
    "defaults": {
      "syncPoint": "immediate"
    },
    "definitions": {
      "template": {
        "description": "Template to use for the sub-process",
        "type": "string",
        "example": "create-process-step-template"
      },
      "parameters": {
        "description": "Parameters to pass to the sub-process",
        "type": "object",
        "example": { "stepName": "my-step", "category": "common" }
      },
      "syncPoint": {
        "description": "When parent waits for sub-process completion",
        "type": "string",
        "enum": ["immediate", "step-N", "end"],
        "default": "immediate"
      }
    }
  },
  "output": {
    "description": "Sub-process created with parent reference, parent memory updated",
    "artifacts": ["sub-process directory", "parent memory update"]
  },
