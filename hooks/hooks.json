{
  "modules": ["./register.ts"],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Task|TaskCreate|TaskUpdate",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/block-todo-tools.sh"]
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/block-approve-step.sh"]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|StrReplace|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/bind-session-to-process.sh"]
          },
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/track-file-change.sh"]
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/check-qa-session.sh"]
          }
        ]
      }
    ]
  }
}
